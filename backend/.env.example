DATABASE_URL=postgresql://user:password@localhost:5432/ajimport
PORT=4000

# Опционально: прокси для обхода блокировок Encar/Che168 (KR/CN IP нужен для che168)
PROXY_URL_KR=
PROXY_URL_CN=

# Курс валют берётся с open.er-api.com/v6/latest/RUB (бесплатно, без ключа) -
# ЦБ РФ официально не публикует курс воны (KRW), поэтому не подходит.

CRON_SCHEDULE=0 */3 * * *
