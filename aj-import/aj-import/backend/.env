DATABASE_URL=postgresql://ajuser:ajpass@localhost:5432/ajimport
PORT=4000

# MOCK_DATA отключён - работаем на реальных данных из Postgres
MOCK_DATA=false

# Опционально: прокси для обхода блокировок Encar/Che168 (KR/CN IP нужен для che168)
PROXY_URL_KR=
PROXY_URL_CN=

# Курс валют берётся с open.er-api.com/v6/latest/RUB (бесплатно, без ключа)

CRON_SCHEDULE=0 */3 * * *
